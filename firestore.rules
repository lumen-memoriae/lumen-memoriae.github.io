rules_version = '2';
// Правила для Firebase → Firestore Database → Rules.
// Замените ВАША_ПОЧТА на почту, под которой вы создали пользователя в Authentication → Users.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'ВАША_ПОЧТА';
    }
    function validFrame(d) {
      return d.keys().hasOnly(['src', 'frame', 'title', 'text', 'owner', 'createdAt', 'override', 'hidden'])
        && (!('src' in d) || (d.src is string && d.src.size() < 1000000))
        && (!('frame' in d) || d.frame in ['wood', 'gold', 'black', 'white'])
        && (!('title' in d) || (d.title is string && d.title.size() <= 80))
        && (!('text' in d) || (d.text is string && d.text.size() <= 1200));
    }
    match /frames/{id} {
      allow read: if true;
      // любой посетитель может повесить рамку от своего имени
      allow create: if request.auth != null && validFrame(request.resource.data)
        && request.resource.data.createdAt == request.time
        && (isAdmin() || (request.resource.data.owner == request.auth.uid
            && !('override' in request.resource.data) && !('hidden' in request.resource.data)
            && request.resource.data.src is string && request.resource.data.title is string));
      // менять может автор рамки или хозяин; автора поменять нельзя
      allow update: if request.auth != null && validFrame(request.resource.data)
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.createdAt == resource.data.createdAt
        && (isAdmin() || resource.data.owner == request.auth.uid);
      // удалять — только хозяин
      allow delete: if isAdmin();
    }
  }
}
